# Telegram
BOT_TOKEN=123456:REPLACE_ME
BOT_USERNAME=YourBotUsername
MINI_APP_URL=https://YOUR-DOMAIN.example

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
PGSSL=true

# Admin panel
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Economy
COIN_NAME=MYCOIN
POINTS_PER_CHECKIN=100
REFERRAL_PERCENT=2
POINTS_PER_USDT=10000
MIN_WITHDRAW_USDT=1

# Ads
# Keep rewards disabled until your ad network has a server-to-server
# reward callback. Never trust a browser-only "ad completed" callback.
ADS_ENABLED=false
AD_CALLBACK_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
